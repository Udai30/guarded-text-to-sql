# Copy to .env and change the passwords. Never commit .env.

# Postgres owner for the Docker container (used only by docker compose and `sqlagent db setup`).
POSTGRES_USER=sqlagent_owner
POSTGRES_PASSWORD=change-me-owner
POSTGRES_DB=adventureworks
PGPORT=5432

# Runtime login role password (role created by `sqlagent db setup` in M1).
SQLAGENT_APP_PASSWORD=change-me-app

# Optional overrides of configs/default.yaml
# SQLAGENT_CONFIG=configs/default.yaml
# SQLAGENT_DB_HOST=localhost
# SQLAGENT_DB_PORT=5432

# Phase 3 live demo only (free-tier hosted LLM). Leave empty for local development.
# LLM_API_KEY=
